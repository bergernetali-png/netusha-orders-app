# העתיקו קובץ זה ל-.env ומלאו ערכים אמיתיים לפני שמריצים בענן.
# בהרצה מקומית בלבד אפשר גם בלי .env — יש ברירות מחדל בקוד (lib/auth.js),
# אבל לפני שהאפליקציה עולה לאינטרנט חובה להגדיר כאן סיסמה וסוד אמיתיים.

# הסיסמה לכניסה למערכת
ADMIN_PASSWORD=change-me-please

# מחרוזת אקראית וסודית לחתימת עוגיית ההתחברות (אפשר להריץ: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=change-me-too

# פורט (ברוב שירותי הענן זה מוגדר אוטומטית ואפשר להשאיר ריק)
PORT=3000
